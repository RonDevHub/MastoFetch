# Schutz vor dem Auslesen der .env und anderer kritischer Systemdateien
<FilesMatch "^\.env|composer\.json|composer\.lock|README\.md">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Deaktiviert das Verzeichnis-Listing
Options -Indexes